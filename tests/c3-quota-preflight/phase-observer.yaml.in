# Test-only privileged observer for persistence phases.
apiVersion: v1
kind: Pod
metadata:
  name: ok176-c3-persist-observer
  namespace: ok176-c3
  labels: {openkubes.io/test-only: "ok-176-c3"}
spec:
  automountServiceAccountToken: false
  nodeSelector: {kubernetes.io/hostname: "__NODE_NAME__"}
  restartPolicy: Never
  containers:
  - name: observer
    terminationMessagePath: /tmp/termination-log
    image: openebs/linux-utils:4.6.0
    securityContext: {privileged: true, allowPrivilegeEscalation: true}
    command: [sh, -ec, "trap 'exit 0' TERM INT; while :; do sleep 3600; done"]
    volumeMounts:
    - {name: base, mountPath: /data, readOnly: true}
    - {name: host-dev, mountPath: /dev, readOnly: true}
    - {name: host-var, mountPath: /host-var, readOnly: true}
    - {name: host-boot-id, mountPath: /host-boot-id, readOnly: true}
  volumes:
  - name: base
    hostPath: {path: /var/openebs/ok176-c3, type: DirectoryOrCreate}
  - name: host-dev
    hostPath: {path: /dev, type: Directory}
  - name: host-var
    hostPath: {path: /var, type: Directory}
  - name: host-boot-id
    hostPath: {path: /proc/sys/kernel/random/boot_id, type: File}
